# 天地图应用Key（请自行申请：https://console.tianditu.gov.cn/）
VITE_TDT_KEY = ''

# 萤石云 accessToken（请自行申请：https://open.ys7.com/）
VITE_YS_ACCESS_TOKEN = ''
